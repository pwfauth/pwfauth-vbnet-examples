<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PwfAuthCSharpClient</RootNamespace>
    <AssemblyName>PwfAuthCSharpClient</AssemblyName>
    <Nullable>disable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official PWF Auth client: https://www.nuget.org/packages/PWFAuth (netstandard2.0) -->
    <PackageReference Include="PWFAuth" Version="1.3.0" />
    <!-- Build-only: lets net481 build even without the local targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
